# Trainer Arena — producción. Copia este archivo a `.env` EN EL SERVIDOR
# (junto a docker-compose.prod.yml) y rellena todos los valores.
# Genera secretos con:  openssl rand -hex 32

# --- Dominio (Caddy emite el certificado TLS automáticamente) ---
DOMAIN=torneos.tudominio.es

# --- App ---
NODE_ENV=production
APP_LOCALE=es
APP_URL=https://torneos.tudominio.es
# URL interna del API para el SSR (red de docker, no cambiar)
API_URL=http://api:3000
API_PORT=3000

# --- Base de datos (el compose construye DATABASE_URL con estos valores) ---
POSTGRES_USER=apptorneos
POSTGRES_PASSWORD=
POSTGRES_DB=apptorneos

# --- Sesiones (¡secretos nuevos, NUNCA los de desarrollo!) ---
SESSION_SECRET=
SESSION_COOKIE_NAME=trainerarena_session

# --- URLs firmadas (verificación de email) ---
APP_KEY=

# --- Mail (transaccional con tu dominio + SPF/DKIM para no caer en spam) ---
# Ejemplos: Brevo smtp-relay.brevo.com:587 (secure=false) · Gmail smtp.gmail.com:465 (secure=true)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=torneos@tudominio.es
MAIL_FROM_NAME="Trainer Arena"

# --- Superadmin (primer arranque: pnpm prisma db seed dentro del contenedor api) ---
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=

# --- Datos demo: SIEMPRE false en producción ---
SEED_DEMO=false

# --- PayPal Checkout v2 (credenciales LIVE de tu cuenta business) ---
# Webhook: créalo en developer.paypal.com apuntando a
#   https://torneos.tudominio.es/api/webhooks/paypal
# con los eventos PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED y
# CHECKOUT.ORDER.VOIDED, y pega aquí su ID.
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- WebSockets (Soketi; el compose pasa estos valores al contenedor) ---
# Genera key y secret aleatorios (openssl rand -hex 16)
PUSHER_APP_ID=trainerarena
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
# Lado cliente: el navegador conecta por wss:// al mismo dominio (Caddy enruta /app/*)
PUBLIC_PUSHER_HOST=torneos.tudominio.es
PUBLIC_PUSHER_PORT=443
PUBLIC_PUSHER_USE_TLS=true
