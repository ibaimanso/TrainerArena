# --- App ---
NODE_ENV=development
APP_LOCALE=es
APP_URL=http://localhost:4200
API_URL=http://localhost:3000
API_PORT=3000

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgresql://apptorneos:apptorneos@localhost:5432/apptorneos?schema=public

# --- Redis (queues / cache / sessions / rate limit) ---
REDIS_URL=redis://localhost:6379

# --- Sessions ---
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=apptorneos_session

# --- Signed URLs (email verification) ---
APP_KEY=change-me-to-another-long-random-string

# --- Mail ---
# Development: Mailpit (SMTP localhost:1025, UI http://localhost:8025).
# Production: point to a real SMTP provider. Examples:
#   Gmail (app password): MAIL_HOST=smtp.gmail.com  MAIL_PORT=465 MAIL_SECURE=true  MAIL_USER=tu@gmail.com MAIL_PASSWORD=<app-password>
#   Brevo:                MAIL_HOST=smtp-relay.brevo.com MAIL_PORT=587 MAIL_SECURE=false MAIL_USER=<login>  MAIL_PASSWORD=<smtp-key>
#   Hosting/cPanel:       MAIL_HOST=mail.tudominio.es MAIL_PORT=465 MAIL_SECURE=true  MAIL_USER=torneos@tudominio.es MAIL_PASSWORD=<password>
# MAIL_FROM_ADDRESS should belong to the authenticated domain (SPF/DKIM) to avoid spam.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=torneos@apptorneos.local
MAIL_FROM_NAME=AppTorneos

# --- Superadmin seeder (required: seeder fails without password) ---
SUPERADMIN_EMAIL=admin@apptorneos.local
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Superadmin

# --- reCAPTCHA v3 (formularios públicos; vacío = desactivado en desarrollo) ---
# Crea las claves (tipo v3) en https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# --- WebSockets (Soketi, Pusher protocol) — server side ---
PUSHER_APP_ID=apptorneos
PUSHER_APP_KEY=apptorneos-key
PUSHER_APP_SECRET=apptorneos-secret
PUSHER_HOST=localhost
PUSHER_PORT=6001
PUSHER_USE_TLS=false

# --- WebSockets — client side (Angular) ---
PUBLIC_PUSHER_APP_KEY=apptorneos-key
PUBLIC_PUSHER_HOST=localhost
PUBLIC_PUSHER_PORT=6001
PUBLIC_PUSHER_USE_TLS=false
